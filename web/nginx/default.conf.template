# The console, over TLS 1.3 with the lab certificate (make gen-certs),
# mounted read-only from vault-tls/. /api and /auth go to the console workload
# (HTTPS, verified against the lab CA). Its streamed answers carry
# X-Accel-Buffering: no, so nginx passes each event on at once.
server {
  listen      8443 ssl;
  http2       on;
  server_name _;

  ssl_certificate     /etc/nginx/tls/vault.crt;
  ssl_certificate_key /etc/nginx/tls/vault.key;
  ssl_protocols       TLSv1.3;
  ssl_session_cache   off;
  server_tokens       off;

  error_page 497 =301 https://$http_host$request_uri;

  # Resolve the API by name per request; requires NGINX_ENTRYPOINT_LOCAL_RESOLVERS=1.
  resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

  add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
  add_header Referrer-Policy no-referrer always;
  add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;

  root  /usr/share/nginx/html;
  index index.html;

  location / {
    try_files $uri $uri/ /index.html;
    add_header Cache-Control "no-cache" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;
  }

  location /assets/ {
    try_files $uri =404;
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types text/css application/javascript image/svg+xml;
    gzip_vary on;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    add_header Strict-Transport-Security "max-age=31536000" always;
  add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'" always;
  }

  # Sign-in round trip (the console is the BFF, D13).
  location /auth/ {
    set $api "https://api:3000";
    proxy_pass $api;
    proxy_ssl_trusted_certificate /etc/nginx/tls/ca-chain.pem;
    proxy_ssl_verify on;
    proxy_ssl_name api;
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }

  location /api/ {
    set $api "https://api:3000";
    proxy_pass $api;
    proxy_ssl_trusted_certificate /etc/nginx/tls/ca-chain.pem;
    proxy_ssl_verify on;
    proxy_ssl_name api;
    proxy_ssl_server_name on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 300s; # an answer from the CPU model can take a while
  }
}

# Container health only; not published.
server {
  listen 8080;
  location = /nginx-health { access_log off; return 200 "ok\n"; }
  location / { return 404; }
}
