# .env: local overrides. Never committed.
# `make env-init` copies this file to .env. Image pins, ports and names live in
# config/defaults.conf; override any of them here (for example a port that
# another project already holds: VPIP_PORT_WEB=13810).
#
# The Vault Enterprise licence: the licence string itself, or a path to a
# .hclic file. `make license` installs it to .secrets/vault/vault.hclic, which
# every Vault node mounts read-only. Nothing else reads this variable.
VAULT_LICENSE=
