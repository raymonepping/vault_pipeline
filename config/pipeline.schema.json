{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config/pipeline.json (scripts/pipeline-check.js holds the rules a schema cannot say)",
  "type": "object",
  "required": ["title", "trust_domain", "subnet", "workloads", "collections", "groups", "operator_group", "people"],
  "properties": {
    "title": { "type": "string" },
    "trust_domain": { "type": "string" },
    "subnet": { "type": "string" },
    "workloads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "spiffe_path", "address", "port", "creates_data_keys", "decrypts", "accepts"],
        "properties": {
          "name": { "type": "string" },
          "spiffe_path": { "type": "string" },
          "address": { "type": "string" },
          "port": { "type": "integer" },
          "creates_data_keys": { "type": "boolean" },
          "decrypts": { "type": "boolean" },
          "accepts": {
            "type": "array",
            "items": { "type": "object", "required": ["from", "op"], "properties": { "from": { "type": "string" }, "op": { "type": "string" } } }
          }
        }
      }
    },
    "collections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "key", "reader_group", "documents"],
        "properties": {
          "name": { "type": "string" },
          "key": { "type": "string" },
          "reader_group": { "type": "string" },
          "documents": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "groups": { "type": "array", "items": { "type": "string" } },
    "operator_group": { "type": "string" },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["user", "name", "groups"],
        "properties": { "user": { "type": "string" }, "name": { "type": "string" }, "groups": { "type": "array", "items": { "type": "string" } } }
      }
    }
  }
}
